{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,

        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["jest", "@testing-library/jest-dom"],
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
